# PostgreSQL
POSTGRES_USER=neurostack
POSTGRES_PASSWORD=neurostack
POSTGRES_DB=neurostack
DATABASE_URL=postgresql+asyncpg://neurostack:neurostack@localhost:5434/neurostack
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
# Seconds a request waits for one of the five per-process connections.
DATABASE_POOL_TIMEOUT=30

# Encrypted PostgreSQL backups. Provision the real recipient and restore URL
# from the deployment secret manager; never commit an age identity here.
BACKUP_DIR=/opt/backups/neurostack
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_SECRET_MANAGER_RECIPIENT
BACKUP_AGE_IDENTITY=/run/secrets/neurostack-backup-age-identity
RESTORE_DATABASE_URL=
RESTORE_EXPECTED_DATABASE=
RETENTION_DAYS=7

# Redis
REDIS_URL=redis://localhost:6380/0

# Built frontend served by the API at exact paths. Empty SPA_DIST_DIR (or no
# index.html in it) serves nothing; the production image sets /app/spa.
SPA_ENABLED=true
SPA_DIST_DIR=

# AWS AppConfig Agent localhost cache. Keep disabled until all three IDs are set.
APPCONFIG_ENABLED=false
APPCONFIG_ORIGIN=http://127.0.0.1:2772
APPCONFIG_APPLICATION=
APPCONFIG_ENVIRONMENT=
APPCONFIG_PROFILE=
# Optional local-agent Bearer token; inject it from the runtime secret manager.
APPCONFIG_TOKEN=

# Billing gateways. Inject real secrets from the deployment secret manager.
# ASAAS uses the fixed production origin https://api.asaas.com/v3 and the
# access_token header; neither is deployment-overridable.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=NeuroStack/asaas-payment-gateway
# Absolute HTTPS billing page the hosted Checkout returns the browser to
# (navigation only; never confirms payment). Empty keeps checkout unavailable.
ASAAS_CHECKOUT_RETURN_URL=
# Public HTTPS URL ending in /v1/billing/webhook/asaas and the operator mailbox
# ASAAS notifies about webhook queue problems. Checkout stays unavailable until
# the provider-side webhook reads back exactly (URL, events, token present).
ASAAS_WEBHOOK_URL=
ASAAS_WEBHOOK_NOTIFICATION_EMAIL=
# Protected: automatic abandonment of ambiguous checkouts. Keep false until
# Group 8 proves by readback that ASAAS copies a Checkout's externalReference.
ASAAS_AUTO_ABANDON_ENABLED=false
# Top-up enablement is persisted/audited server-side and remains closed until
# the credit-ledger capability receipt is verified. There is no env override.

# Billing control-plane operator receipts. The backend alone signs them with
# this key (operators never send or see a signature). The lifetime cap is the
# most an assignment/receipt expires_at may lie after its creation:
# 1..604800 seconds, default 86400 (24 h).
BILLING_OPERATION_RECEIPT_SIGNING_KEY=
BILLING_OPERATION_RECEIPT_MAX_TTL_SECONDS=86400

# Production observability smoke. Inject from the deployment secret manager;
# the verifier requires a fresh receiver-signed Ed25519 receipt for the
# backend-issued challenge; the receiver's private key never enters this app.
BILLING_OBSERVABILITY_SMOKE_TOKEN=
BILLING_FACT_SCHEMA_DIGEST=
BILLING_OBSERVABILITY_ACKNOWLEDGEMENT=
BILLING_OBSERVABILITY_ACKNOWLEDGEMENT_DIGEST=
BILLING_OBSERVABILITY_CHALLENGE_NONCE=
BILLING_OBSERVABILITY_CHALLENGE_DIGEST=
BILLING_OBSERVABILITY_ACKNOWLEDGEMENT_PUBLIC_KEY=

# billing.fact.v1 outbox worker. Off by default: false starts no loop and no
# database work. When true each API worker process runs one bounded loop that
# reconciles acks, escalates facts unacknowledged beyond the stale threshold
# and (once a credit consumer is wired) presents due facts with a bounded
# retry before the terminal blocked state. Facts are never deleted.
BILLING_FACT_WORKER_ENABLED=false
BILLING_FACT_WORKER_INTERVAL_SECONDS=30
BILLING_FACT_WORKER_BATCH_SIZE=50
BILLING_FACT_WORKER_MAX_ATTEMPTS=10
BILLING_FACT_WORKER_STALE_AFTER_SECONDS=900

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM Provider (OpenAI-compatible)
LLM_BASE_URL=https://api.neuralake.cloud/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# SMTP (Support Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL_TO=info@neurostack.global

# NeuroStack Start plan usage limits
START_PLAN_MONTHLY_TRACE_LIMIT=10000
START_PLAN_RAG_STORAGE_LIMIT_MB=500
START_PLAN_MEDIA_STORAGE_LIMIT_MB=500
