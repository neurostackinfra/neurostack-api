# Force LF on checkout for source files everywhere, so editing on
# Windows/WSL (drvfs) does not rewrite them as CRLF and churn the diff.
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf

# Leave already-committed CRLF data dumps as-is (no normalization).
frontend/attached_assets/** -text
load_test_results/**        -text
