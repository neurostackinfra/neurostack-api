    {
      "parameters": {
        "jsCode": "// Preparar prompt para LLM\nconst neurostackResponse = $input.item.json;\nconst sessionData = $('Preparar Dados da Sessão').item.json;\n\nconst prompt = neurostackResponse.prompt || {};\nconst context = neurostackResponse.context || {};\n\n// Construir system prompt\nlet systemPrompt = prompt.system || 'Você é um assistente de saúde amigável e profissional.';\n\n// Adicionar constraints\nif (prompt.constraints && prompt.constraints.length > 0) {\n  systemPrompt += '\\n\\nRESTRIÇÕES IMPORTANTES:\\n';\n  prompt.constraints.forEach(c => {\n    systemPrompt += `- ${c}\\n`;\n  });\n}\n\n// Preparar histórico de mensagens\nconst messages = [];\n\n// System prompt\nmessages.push({\n  role: 'system',\n  content: systemPrompt\n});\n\n// Histórico recente\nif (context.recent_messages) {\n  context.recent_messages.slice(-5).forEach(msg => {\n    messages.push({\n      role: msg.role || 'user',\n      content: msg.content || ''\n    });\n  });\n}\n\n// Mensagem atual\nmessages.push({\n  role: 'user',\n  content: sessionData.user_message\n});\n\n// Instruções específicas\nif (prompt.instructions) {\n  messages.push({\n    role: 'system',\n    content: `Instruções para esta resposta: ${prompt.instructions}`\n  });\n}\n\nreturn {\n  json: {\n    messages: messages,\n    intent: neurostackResponse.decision?.intent || 'unknown',\n    funnel_stage: neurostackResponse.decision?.funnel_stage || 'unknown',\n    session_id: sessionData.session_id,\n    user_id: sessionData.user_id,\n    channel: sessionData.channel,\n    mode: neurostackResponse.mode || 'normal',\n    temperature: 0.7,\n    max_tokens: 500\n  }\n};"
      },
      "id": "prepare-llm",
      "name": "Preparar Prompt para LLM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 400],
      "notes": "Prepara mensagens para OpenAI"
    },
