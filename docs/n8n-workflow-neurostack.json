      "parameters": {
        "model": "gpt-4",
        "options": {
          "temperature": "={{ $json.temperature }}",
          "maxTokens": "={{ $json.max_tokens }}"
        },
        "messages": {
          "values": "={{ $json.messages }}"
        }
      },
      "id": "call-openai",
      "name": "Gerar Resposta com OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [2440, 400],
      "credentials": {
