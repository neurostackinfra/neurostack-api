      },
      "id": "webhook-receive",
      "name": "Webhook - Receber Mensagem",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "neurostack-chat-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Extrair dados da mensagem recebida\nconst body = $input.item.json || {};\n\n// Suporta diferentes formatos de entrada\nlet userMessage = '';\nlet userId = 'unknown';\nlet channel = 'whatsapp';\n\n// Tentar múltiplos formatos de entrada\n\n// 1. Formato direto simples\nif (body.message && typeof body.message === 'string') {\n  userMessage = body.message;\n  userId = body.user_id || body.userId || body.from || 'unknown';\n  channel = body.channel || 'whatsapp';\n}\n// 2. Formato com campo 'text'\nelse if (body.text && typeof body.text === 'string') {\n  userMessage = body.text;\n  userId = body.from || body.user_id || body.userId || 'unknown';\n  channel = body.channel || 'whatsapp';\n}\n// 3. Formato WhatsApp Business API\nelse if (body.entry && Array.isArray(body.entry) && body.entry.length > 0) {\n  const entry = body.entry[0]?.changes?.[0]?.value;\n  if (entry?.messages?.[0]) {\n    const msg = entry.messages[0];\n    userMessage = msg.text?.body || msg.body || '';\n    userId = msg.from || entry.contacts?.[0]?.wa_id || 'unknown';\n    channel = 'whatsapp';\n  }\n}\n// 4. Formato com 'content'\nelse if (body.content && typeof body.content === 'string') {\n  userMessage = body.content;\n  userId = body.user_id || body.userId || body.from || 'unknown';\n  channel = body.channel || 'whatsapp';\n}\n// 5. Formato com 'payload'\nelse if (body.payload) {\n  const payload = body.payload;\n  userMessage = payload.content || payload.message || payload.text || '';\n  userId = payload.user_id || payload.userId || payload.from || 'unknown';\n  channel = payload.channel || 'whatsapp';\n}\n// 6. Tentar extrair do body diretamente (último recurso)\nelse if (typeof body === 'string') {\n  userMessage = body;\n  userId = 'unknown';\n  channel = 'whatsapp';\n}\n// 7. Se body é um objeto, tentar encontrar qualquer campo de texto\nelse if (typeof body === 'object' && body !== null) {\n  // Procurar por campos comuns que podem conter a mensagem\n  const textFields = ['message', 'text', 'content', 'body', 'input', 'query', 'prompt'];\n  for (const field of textFields) {\n    if (body[field] && typeof body[field] === 'string' && body[field].trim().length > 0) {\n      userMessage = body[field];\n      break;\n    }\n  }\n  \n  // Procurar por campos comuns que podem conter user_id\n  const idFields = ['user_id', 'userId', 'from', 'sender', 'user', 'chat_id'];\n  for (const field of idFields) {\n    if (body[field]) {\n      userId = String(body[field]);\n      break;\n    }\n  }\n  \n  channel = body.channel || 'whatsapp';\n}\n\n// Validar que temos pelo menos uma mensagem\nif (!userMessage || userMessage.trim().length === 0) {\n  // Se não encontrou mensagem, usar um valor padrão ou o body inteiro como string\n  userMessage = JSON.stringify(body).substring(0, 500);\n}\n\n// Função para gerar GUID (UUID v4)\nfunction generateGuid() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.random() * 16 | 0;\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\n// Verificar se já existe session_id no payload, senão gerar um novo GUID\nlet sessionId = body.session_id || body.sessionId || body.body.session_id;\nif (!sessionId || typeof sessionId !== 'string' || sessionId.trim().length === 0) {\n  sessionId = generateGuid();\n}\n\n// Adicionar timestamp único para evitar colisões\nconst timestamp = new Date().toISOString();\n\nreturn {\n  json: {\n    user_message: userMessage.trim(),\n    user_id: userId,\n    channel: channel,\n    session_id: sessionId,\n    timestamp: timestamp,\n    raw_body: body // Incluir body original para debug\n  }\n};"
      },
