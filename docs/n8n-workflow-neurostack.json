    {
      "parameters": {
        "jsCode": "// Preparar resposta final\nconst openaiResponse = $input.item.json;\nconst llmData = $('Preparar Prompt para LLM').item.json;\nconst sessionData = $('Preparar Dados da Sessão').item.json;\n\nconst reply = openaiResponse.choices?.[0]?.message?.content || 'Desculpe, não consegui processar sua mensagem.';\n\nreturn {\n  json: {\n    reply: reply,\n    intent: llmData.intent,\n    funnel_stage: llmData.funnel_stage,\n    session_id: sessionData.session_id,\n    user_id: sessionData.user_id,\n    channel: sessionData.channel,\n    handoff_required: false,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
