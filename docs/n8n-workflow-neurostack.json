    {
      "parameters": {
        "jsCode": "// Preparar dados para handoff\nconst neurostackResponse = $input.item.json;\nconst sessionData = $('Preparar Dados da Sessão').item.json;\n\nconst handoffInfo = neurostackResponse.handoff_summary || {};\n\nreturn {\n  json: {\n    user_id: sessionData.user_id,\n    session_id: sessionData.session_id,\n    reason: neurostackResponse.decision?.handoff_reason || 'unknown',\n    summary: handoffInfo.summary || 'Handoff necessário',\n    key_info: handoffInfo.key_info || {},\n    urgency: handoffInfo.urgency || 'normal',\n    message: 'Vou transferir você para um de nossos atendentes. Aguarde um momento, por favor.'\n  }\n};"
      },
      "id": "prepare-handoff",
      "name": "Preparar Handoff",
      "type": "n8n-nodes-base.code",
