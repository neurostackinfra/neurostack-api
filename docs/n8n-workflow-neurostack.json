    {
      "parameters": {
        "jsCode": "// Unificar dados da sessão (criada ou existente)\nconst sessionData = $input.item.json;\nconst messageData = $('Extrair Dados da Mensagem').item.json;\n\nreturn {\n  json: {\n    session_id: sessionData.id || sessionData.session_id || messageData.session_id,\n    user_id: messageData.user_id,\n    user_message: messageData.user_message,\n    channel: messageData.channel\n  }\n};"
      },
