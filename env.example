# ============================================
# NeuroStack API - Environment Variables
# Copy this file to .env and adjust values
# ============================================

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME="NeuroStack API"
APP_VERSION=0.1.0
API_PREFIX=/v1
DOCS_ENABLED=true
REDOC_JS_URL=https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-required
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]

# Database (PostgreSQL)
POSTGRES_USER=neurostack
POSTGRES_PASSWORD=neurostack
POSTGRES_DB=neurostack
DATABASE_URL=postgresql+asyncpg://neurostack:neurostack@localhost:5432/neurostack
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5.0

# Qdrant (Vector Database)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=neurostack_knowledge

# Session Configuration
SESSION_TTL_SECONDS=86400
SESSION_MAX_MESSAGES=50

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_INCLUDE_REQUEST_BODY=false

# Observability
TRACING_ENABLED=false
TRACING_SAMPLE_RATE=0.1
METRICS_ENABLED=true
METRICS_PORT=9090

# SRM Configuration
SRM_CONFIDENCE_THRESHOLD=0.7
SRM_SAFETY_THRESHOLD=0.5
SRM_HANDOFF_MAX_TURNS=10

# Prompt Engine
PROMPT_MAX_CONTEXT_TOKENS=4000
PROMPT_MAX_RECENT_MESSAGES=10
