# Synthetic, non-secret inputs for rendering docker-compose.production.yml.
# Shared by tests/scripts/test_production_compose.py and the
# asaas_release_candidate_gate in scripts/wish-gates.sh, so the release gate
# never needs (or reads) real production secrets. Every `${VAR:?...}` in the
# production compose must appear here; a test enforces it.
GEMINI_IMAGE_DIGEST=registry.example/neurostack/api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SECRET_KEY=SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS
ALLOWED_ORIGINS=["https://app.production.invalid"]
ALLOWED_HOSTS=["api.production.invalid"]
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP
POSTGRES_DB=prod_db
REDIS_PASSWORD=RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
QDRANT_API_KEY=QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
ASAAS_API_KEY=test-asaas-api-key
ASAAS_WEBHOOK_TOKEN=test-asaas-webhook-token
BILLING_OPERATION_RECEIPT_SIGNING_KEY=KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK
BILLING_PROMETHEUS_RULES_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BILLING_OBSERVABILITY_SMOKE_DIGEST=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
BILLING_OBSERVABILITY_SMOKE_TOKEN=TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT
BILLING_FACT_SCHEMA_DIGEST=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
BILLING_OBSERVABILITY_ACKNOWLEDGEMENT={}
BILLING_OBSERVABILITY_ACKNOWLEDGEMENT_DIGEST=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
BILLING_ALERT_RECEIVER_URL=https://alerts.production.invalid/v1/billing
